{
  "name": "bodenseeguide",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @lake/web dev",
    "build": "corepack pnpm -r --if-present build",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm --filter @lake/domain build && corepack pnpm --filter @lake/db build && corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "db:migrate": "corepack pnpm --filter @lake/db db:migrate",
    "db:seed": "corepack pnpm --filter @lake/db db:seed",
    "db:diff": "corepack pnpm --filter @lake/db db:diff",
    "db:reset": "docker compose down --volumes && docker compose up --detach --wait && corepack pnpm db:migrate && corepack pnpm db:seed",
    "format": "prettier --check .",
    "research:validate": "corepack pnpm --filter @lake/domain build && node tools/research-validate.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
