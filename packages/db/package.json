{
  "name": "@lake/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc --project tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit --project tsconfig.json",
    "test": "prisma generate && vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:diff": "node scripts/migrate-diff.mjs",
    "db:seed": "tsx seed/geo.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "argon2": "^0.45.1"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "eslint": "^9.32.0",
    "pg": "^8.16.3",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
