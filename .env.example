# PostgreSQL connection used by the application and Prisma.
DATABASE_URL=postgresql://lake:lake@localhost:5432/lake?schema=public

# Secret used to sign administrator sessions.
ADMIN_AUTH_SECRET=

# EU transactional email adapter used for administrator password resets.
ADMIN_EMAIL_ENDPOINT=
ADMIN_EMAIL_API_KEY=
ADMIN_EMAIL_FROM=

# Optional initial administrator seed values. The password is never committed.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_ROLE=ADMIN

# Bearer secret accepted by scheduled-job endpoints.
JOB_TRIGGER_SECRET=

# Base URL of the configured map-tile provider.
MAP_TILE_URL=

# API key for the configured map-tile provider.
MAP_TILE_API_KEY=

# Permanent provider attribution metadata for the map surface.
MAP_TILE_PROVIDER_NAME=
MAP_TILE_PROVIDER_URL=
MAP_TILE_ATTRIBUTION=

# Base URL of the configured geocoding provider.
GEOCODER_URL=

# API key for the configured geocoding provider.
GEOCODER_API_KEY=

# Base URL of the configured weather provider.
WEATHER_API_URL=

# API key for the configured weather provider.
WEATHER_API_KEY=

# Hostname or URL of the privacy-friendly analytics service.
ANALYTICS_DOMAIN=

# Maximum distance from the shoreline for automatic scope inclusion, in kilometres.
SCOPE_SHORELINE_BAND_KM=5

# Canonical public base URL used for sitemap and share-link generation.
PUBLIC_BASE_URL=http://localhost:3000

# S3-compatible image storage used by the licensed attraction image pipeline.
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_REGION=eu-central-1
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_ACCESS_KEY_ID=
IMAGE_STORAGE_SECRET_ACCESS_KEY=
IMAGE_STORAGE_PUBLIC_BASE_URL=
IMAGE_STORAGE_FORCE_PATH_STYLE=false
IMAGE_STORAGE_DRIVER=s3

# Optional local integration-test switches. Keep both disabled for normal development.
RUN_IMPORT_INTEGRATION=0
RUN_REVIEW_INTEGRATION=0

# Separate database used by `prisma migrate diff` as a shadow database.
SHADOW_DATABASE_URL=